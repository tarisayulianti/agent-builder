# Agent Calling Agent Builder — Environment Configuration
# Copy file ini ke .env dan sesuaikan nilai berikut

# ── Hermes Configuration ──
HERMES_MODEL=solar-pro4:free
HERMES_PROVIDER=nous

# ── Agent Configuration ──
# Role Agent 1: orchestrator
AGENT1_ROLE=orchestrator

# Mode Agent 2: hermes-chat (default V1), atau tmux (V2+)
# V1: Gunakan hermes chat -q (one-shot CLI invocation)
# V2+: Bisa pakai tmux untuk interactive Agent 2 instance
AGENT2_MODE=hermes-chat

# ── Timeout & Retry ──
# Timeout per-task dalam menit
TIMEOUT_MINUTES=15

# Max koreksi jika output salah
MAX_RETRIES=2

# ── Logging ──
# Level: debug, info, warn, error
LOG_LEVEL=info

# Lokasi folder logs relatif ke root project
LOG_DIR=logs

# ── Infrastructure (V2+) ──
# Port WebSocket server (V5)
WEBSOCKET_PORT=8765

# Port REST API server (V7)
API_PORT=5000

# ── External Integrations (V4) ──
# Jira
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_TOKEN=your-jira-token
# JIRA_EMAIL=your-email@domain.com

# Trello
# TRELLO_API_KEY=your-trello-key
# TRELLO_TOKEN=your-trello-token
# TRELLO_BOARD_ID=your-board-id

# Jenkins
# JENKINS_URL=http://localhost:8080
# JENKINS_USER=your-username
# JENKINS_TOKEN=your-token

# GitLab
# GITLAB_URL=https://gitlab.com
# GITLAB_TOKEN=your-gitlab-token

# ── ML Configuration (V3/V6) ──
# Threshold success rate untuk rekomendasikan capability (0-1)
ML_SUCCESS_THRESHOLD=0.7

# Jumlah task minimum untuk mulai rekomendasi ML
ML_MIN_TASKS=10
