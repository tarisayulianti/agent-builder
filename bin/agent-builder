#!/usr/bin/env bash
#
# bin/agent-builder — CLI wrapper untuk Agent Calling Agent Builder
#
# Command:
#   agent-builder help     Tampilkan help
#   agent-builder status   Lihat status Agent 2
#   agent-builder logs     Lihat riwayat siklus
#   agent-builder plan     Plan task (interactive)
#   agent-builder run      Run task (non-interactive)
#   agent-builder reset    Reset status
#
# Usage:
#   ./bin/agent-builder help
#   ./bin/agent-builder status
#   ./bin/agent-builder plan "Buat script Python fibonacci"
#   ./bin/agent-builder run "Buat script Python fibonacci"
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Path Windows untuk Python (karena MSYS path conversion tidak selalu bekerja)
PYTHON="/c/Users/User/AppData/Local/hermes/hermes-agent/venv/Scripts/python.exe"

# Warna
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ── Help ───────────────────────────────────────────────────────────

show_help() {
    cat << EOF
=== agent-builder — Agent Calling Agent Builder CLI (V1) ===

Usage:
    $(basename "$0") <command> [args...]

Commands:
    help              Tampilkan help ini
    status            Lihat status Agent 2
    logs              Lihat riwayat siklus orchestrator
    plan <task>       Mode interactive: plan → review → execute loop
    run <task>        Mode non-interactive: eksekusi otomatis
    reset             Reset status dan riwayat

Contoh:
    $(basename "$0") help
    $(basename "$0") status
    $(basename "$0") plan "Buat script Python fibonacci"
    $(basename "$0") run "Buat script Python fibonacci"
    $(basename "$0") logs
    $(basename "$0") reset

Environment:
    TIMEOUT_MINUTES     Timeout per-task dalam menit (default: 15)
    HERMES_MODEL        Model Hermes yang digunakan
    HERMES_PROVIDER     Provider Hermes

Catatan:
    - V1 menggunakan hermes chat -q (one-shot CLI invocation)
    - V2+ bisa menggunakan tmux (opsional)
    - Docker TIDAK digunakan

EOF
}

# ── Status ─────────────────────────────────────────────────────────

show_status() {
    # Gunakan absolute Windows path secara eksplisit
    local status_file="F:/AI-AGENT/agent-builder/logs/status/agent_status.json"

    if [ ! -f "$status_file" ]; then
        echo -e "${YELLOW}Belum ada status data.${NC}"
        echo "Jalankan '$(basename "$0") plan <task>' atau '$(basename "$0") run <task>' untuk memulai."
        return
    fi

    echo -e "${BLUE}=== Status Agent 2 ===${NC}"
    echo ""

    # Parse JSON sederhana dengan python
    $PYTHON -c "
import json
import sys

try:
    with open('F:/AI-AGENT/agent-builder/logs/status/agent_status.json', 'r') as f:
        data = json.load(f)
   
    
    agents = data.get('agents', {})
    if not agents:
        print('Tidak ada agent yang terekam.')
        sys.exit(0)
    
    for agent_id, agent in agents.items():
        print(f'Agent: {agent.get(\"id\", agent_id)}')
        print(f'Status: {agent.get(\"status\", \"N/A\")}')
        print(f'Task ID: {agent.get(\"task_id\", \"None\")}')
        print(f'Progress: {agent.get(\"progress\", \"0%\")}')
        print(f'Failing case: {agent.get(\"failing_case\", \"None\")}')
        print(f'Updated: {agent.get(\"updated_at\", \"N/A\")}')
        if agent.get('error'):
            print(f'Error: {agent.get(\"error\")}')
        print()
except Exception as e:
    print(f'Error membaca status: {e}')
    sys.exit(1)
"
}

# ── Logs ───────────────────────────────────────────────────────────

show_logs() {
    # Gunakan absolute Windows path secara eksplisit
    local history_file="F:/AI-AGENT/agent-builder/logs/history/task_history.json"

    if [ ! -f "$history_file" ]; then
        echo -e "${YELLOW}Belum ada riwayat siklus.${NC}"
        return
    fi

    echo -e "${BLUE}=== Riwayat Siklus ===${NC}"
    echo ""

    $PYTHON -c "
import json
import sys

try:
    with open('F:/AI-AGENT/agent-builder/logs/history/task_history.json', 'r') as f:
        data = json.load(f)
    
    cycles = data.get('cycles', [])
    if not cycles:
        print('Belum ada siklus.')
        sys.exit(0)
    
    print(f'Total cycle: {len(cycles)}\n')
    for entry in reversed(cycles[-10:]):
        print(f'[{entry[\"cycle_id\"]}] {entry[\"timestamp\"]}')
        print(f'  Trigger: {entry[\"trigger\"][:80]}')
        print(f'  Decision: {entry[\"decision\"]}')
        print()
except Exception as e:
    print(f'Error membaca riwayat: {e}')
    sys.exit(1)
"
}

# ── Plan ───────────────────────────────────────────────────────────

do_plan() {
    local task="$1"

    if [ -z "$task" ]; then
        echo -e "${RED}❌  Error: task description diperlukan.${NC}"
        echo "Gunakan: $(basename "$0") plan \"<deskripsi task>\""
        return 1
    fi

    echo -e "${GREEN}▶  Memulai mode plan: $task${NC}"
    echo ""

    cd "$PROJECT_ROOT"
    $PYTHON orca.py plan "$task"
}

# ── Run ────────────────────────────────────────────────────────────

do_run() {
    local task="$1"

    if [ -z "$task" ]; then
        echo -e "${RED}❌  Error: task description diperlukan.${NC}"
        echo "Gunakan: $(basename "$0") run \"<deskripsi task>\""
        return 1
    fi

    echo -e "${GREEN}▶  Memulai mode run: $task${NC}"
    echo ""

    cd "$PROJECT_ROOT"
    $PYTHON orca.py run "$task"
}

# ── Reset ──────────────────────────────────────────────────────────

do_reset() {
    echo -e "${YELLOW}⚠️  Reset status dan riwayat? (y/n)${NC}"
    read -r confirm
    if [ "$confirm" = "y" ]; then
        cd "$PROJECT_ROOT"
        python3 orca.py reset
        echo -e "${GREEN}✅  Status dan riwayat direset.${NC}"
    else
        echo "Dibatalkan."
    fi
}

# ── Main ───────────────────────────────────────────────────────────

COMMAND="$1"
shift || true
ARGS="$@"

case "$COMMAND" in
    help|--help|-h|"")
        show_help
        ;;
    status)
        show_status
        ;;
    logs)
        show_logs
        ;;
    plan)
        do_plan "$ARGS"
        ;;
    run)
        do_run "$ARGS"
        ;;
    reset)
        do_reset
        ;;
    version|--version|-v)
        echo "agent-builder version 1.0.0 (V1)"
        echo "Dibuat: 2026-09-28"
        ;;
    *)
        echo -e "${RED}❌  Command tidak dikenal: $COMMAND${NC}"
        echo "Gunakan '$(basename "$0") help' untuk melihat command yang tersedia."
        exit 1
        ;;
esac
